{
	"name": "@chordproject/editor",
	"version": "1.1.0",
	"type": "module",
	"description": "A CodeMirror 6 based editor for ChordPro songs.",
	"module": "dist/index.js",
	"main": "dist/index.cjs",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"sideEffects": false,
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=20.19.0"
	},
	"keywords": [
		"chordpro",
		"chordproject",
		"editor",
		"chord",
		"guitar",
		"codemirror"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/chordproject/chordproject-editor"
	},
	"author": "ChordProject (http://chordproject.com)",
	"license": "AGPL-3.0-only",
	"scripts": {
		"dev": "lsof -tiTCP:5173 -sTCP:LISTEN | xargs -r kill 2>/dev/null; vite demo --port 5173 --strictPort",
		"build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
		"test": "npm run build && node --test tests/chordNotation.test.mjs",
		"build:demo": "vite build demo --outDir ../demo-dist",
		"release": "npm run build && npm publish"
	},
	"devDependencies": {
		"tsup": "^8.3.5",
		"typescript": "^5.7.2",
		"vite": "^6.0.7"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.18.4",
		"@codemirror/commands": "^6.8.0",
		"@codemirror/language": "^6.10.8",
		"@codemirror/lint": "^6.8.4",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.36.1",
		"@lezer/highlight": "^1.2.1"
	},
	"peerDependencies": {
		"@chordproject/parser": "^1.0.0"
	}
}
